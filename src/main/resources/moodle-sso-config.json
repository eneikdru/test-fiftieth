{
  "moodle_sso_enabled": true,
  "server_url": "https://moodle.epidemiology-inst.ru",
  "client_id": "epidemiology_portal",
  "redirect_uri": "http://localhost:8080/auth/moodle/callback",
  "role_mappings": [
    {
      "moodle_role_pattern": "administrator",
      "internal_role": "ADMIN"
    },
    {
      "moodle_role_pattern": "teacher",
      "internal_role": "EPIDEMIOLOGIST"
    },
    {
      "moodle_role_pattern": "student",
      "internal_role": "RESEARCHER"
    }
  ],
  "validation_rules": {
    "auth_required": true,
    "require_moodle_token": true
  }
}
