+@SpringBootTest
+@Transactional
+class DataSubjectRightsVerificationTest {
+
+    @Autowired
+    private DataExportJobRepository exportJobRepository;
+
+    @Autowired
+    private DataErasureJobRepository erasureJobRepository;
+
+    @Autowired
+    private UserRepository userRepository;
