+                      ${state.isUploading ? 'disabled' : ''}
+                      class="min-h-[44px] min-w-[44px] px-4 py-2 bg-[#003f87] text-white text-xs font-medium rounded-md"
+                    >
+                      ${state.isUploading ? 'Загрузка...' : 'Сохранить и загрузить'}
+                    </button>
+                  </div>
+                </form>
+              </div>
+            </div>
+          ` : ''}
+
+          <!-- Privacy Delete Confirmation Modal -->
+          ${state.isPrivacyDeleteModalOpen ? `
+            <div id="delete-confirmation-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
+              <div class="bg-white rounded-xl border-2 border-[#ba1a1a] max-w-lg w-full p-6 shadow-2xl my-8">
+                <div class="flex items-start justify-between pb-3 border-b border-[#ffdad6] mb-4">
+                  <h3 class="text-lg font-bold text-[#ba1a1a]">Подтверждение удаления аккаунта (152-ФЗ)</h3>
+                  <button
+                    type="button"
+                    onclick="state.isPrivacyDeleteModalOpen = false; render();"
+                    class="text-[#737688] hover:text-[#191c1e] text-xl font-bold p-1 rounded-full"
+                  >
+                    ✕
+                  </button>
+                </div>
+
+                ${state.privacyDeleteError ? `
+                  <div id="delete-error-alert" role="alert" class="mb-4 p-3.5 rounded-lg bg-[#ffdad6] text-[#93000a] text-xs font-medium border border-[#ba1a1a]/30">
+                    ⚠ ${state.privacyDeleteError}
+                  </div>
+                ` : ''}
+
+                <form onsubmit="handleConfirmPrivacyDelete(event)" class="space-y-4">
+                  <div>
+                    <label for="confirmation-input" class="block text-xs font-bold text-[#ba1a1a] mb-1">
+                      Введите фразовый код: <span class="bg-[#ffdad6] px-1.5 py-0.5 rounded font-mono">УДАЛИТЬ ${state.currentUser.username}</span>
+                    </label>
+                    <input
+                      id="confirmation-input"
+                      type="text"
+                      value="${state.confirmationInput}"
+                      oninput="state.confirmationInput = this.value"
+                      required
+                      class="w-full h-11 px-3.5 bg-[#f7f9fb] border-2 border-[#ba1a1a]/50 rounded-lg text-sm text-[#191c1e] font-mono"
+                    />
+                  </div>
+
+                  <div class="flex items-center justify-end gap-3 pt-4 border-t border-[#e0e3e5]">
+                    <button
+                      type="button"
+                      onclick="state.isPrivacyDeleteModalOpen = false; render();"
+                      class="min-h-[44px] min-w-[44px] px-4 py-2.5 border border-[#c2c6d4] text-[#424752] text-xs font-medium rounded-lg"
+                    >
+                      Отмена
+                    </button>
+                    <button
+                      type="submit"
+                      id="confirm-delete-btn"
+                      class="min-h-[44px] min-w-[44px] px-5 py-2.5 bg-[#ba1a1a] hover:bg-[#93000a] text-white text-xs font-bold rounded-lg shadow-md"
+                    >
+                      ${state.isDeletingPrivacy ? 'Удаление...' : 'Да, удалить аккаунт навсегда'}
+                    </button>
+                  </div>
+                </form>
+              </div>
+            </div>
+          ` : ''}
+
+          <!-- Footer -->
+          <footer class="w-full py-6 mt-12 text-center text-xs text-[#727784] border-t border-[#e0e3e5] flex flex-col sm:flex-row items-center justify-between max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
+            <p>Российский научно-исследовательский институт эпидемиологии</p>
+            <div>
+              <button
+                type="button"
+                id="imprint-link-harness"
+                onclick="alert('Выходные данные (Imprint / Impressum):\nФБУН «НИИ Эпидемиологии»\nг. Москва, ул. Новогиреевская, 3А\nТел: +7 (495) 123-45-67')"
+                class="text-[#003f87] hover:underline focus:outline-none focus:ring-2 focus:ring-[#003f87]/50 rounded px-1 font-semibold"
+              >
+                Выходные данные (Imprint / Impressum)
+              </button>
+            </div>
+          </footer>
+        </div>
+      `;
+    }
+
+    function handleLoginSubmit(event) {
+      if (event) event.preventDefault();
+      if (state.loginUsername === 'employee_user') {
+        state.currentUser.role = 'RESEARCHER';
+        state.currentUser.full_name = 'Петров П.П. (Сотрудник)';
+      } else {
+        state.currentUser.role = 'ADMIN';
+        state.currentUser.full_name = 'Иванов И.И. (Администратор)';
+      }
+      state.mode = 'catalog';
+      fetchDocuments();
+    }
+
+    function handleLogout() {
+      state.mode = "login";
+      state.loginUsername = "";
+      state.loginPassword = "";
+      state.currentUser = { id: null, username: "", role: "", full_name: "", email: "" };
+      render();
+    }
+
+    function handleRecoverySubmit(event) {
+      if (event) event.preventDefault();
+      state.recoverySent = true;
+      render();
+    }
+
+    function handleSearchSubmit(event) {
+      if (event) event.preventDefault();
+      fetchDocuments();
+    }
+
+    function handleResetSearch() {
+      state.searchQuery = '';
+      state.selectedAuthor = '';
+      state.selectedYear = '';
+      fetchDocuments();
+    }
+
+    function openUploadModal() {
+      state.uploadError = '';
+      state.uploadSuccess = '';
+      state.isUploadModalOpen = true;
+      render();
+    }
+
+    function closeUploadModal() {
+      state.isUploadModalOpen = false;
+      render();
+    }
+
+    function handleUploadSubmit(event) {
+      if (event) event.preventDefault();
+      state.uploadError = '';
+      state.uploadSuccess = '';
+
+      if (!state.uploadTitle.trim() || !state.uploadAuthor.trim() || !state.uploadYear) {
+        state.uploadError = 'Заполните все обязательные поля формы.';
+        render();
+        return;
+      }
+
+      state.isUploading = true;
+      render();
+
+      setTimeout(() => {
+        if (state.simulateNetworkError) {
+          state.uploadError = 'Ошибка сети при загрузке документа. Попробуйте еще раз.';
+          state.isUploading = false;
+          render();
+          return;
+        }
+
+        const titleSlug = state.uploadTitle.trim().toLowerCase().replace(/\s+/g, '-');
+        const newDoc = {
+          id: `doc-${titleSlug}-${state.uploadYear}`,
+          title: state.uploadTitle.trim(),
+          author: state.uploadAuthor.trim(),
+          authorOrganization: state.uploadAuthor.trim(),
+          year: parseInt(state.uploadYear, 10),
+          publicationYear: parseInt(state.uploadYear, 10),
+          docType: state.uploadDocType,
+          fileName: state.uploadFileName || 'document.pdf',
+          fileSize: '1.2 МБ',
+          description: state.uploadDescription.trim() || 'Загруженный документ'
+        };
+
+        state.documents.unshift(newDoc);
+        defaultSampleDocuments.unshift(newDoc);
+        state.uploadSuccess = 'Документ успешно загружен в каталог.';
+
+        state.uploadTitle = '';
+        state.uploadAuthor = '';
+        state.uploadYear = '2024';
+        state.uploadDocType = 'Протокол расследования';
+        state.uploadDescription = '';
+        state.uploadFileName = '';
+        state.isUploading = false;
+        state.isUploadModalOpen = false;
+        render();
+      }, 300);
+    }
+
+    function handleDownloadDocument(id) {
+      const doc = state.documents.find(d => String(d.id) === String(id)) || defaultSampleDocuments.find(d => String(d.id) === String(id));
+      const downloadUrl = `/api/v1/documents/${id}/download`;
+      const fileName = doc ? (doc.fileName || doc.filePath?.substring(doc.filePath.lastIndexOf('/') + 1) || 'document.pdf') : `document_${id}.pdf`;
+
+      const a = document.createElement('a');
+      a.href = downloadUrl;
+      a.download = fileName;
+      document.body.appendChild(a);
+      a.click();
+      document.body.removeChild(a);
+    }
+
+    function handleDeleteDocument(id) {
+      state.documents = state.documents.filter(doc => String(doc.id) !== String(id));
+      const idx = defaultSampleDocuments.findIndex(doc => String(doc.id) === String(id));
+      if (idx !== -1) {
+        defaultSampleDocuments.splice(idx, 1);
+      }
+      render();
+    }
+
+    function toggleRole() {
+      if (state.currentUser.role === 'ADMIN') {
+        state.currentUser.role = 'RESEARCHER';
+        state.currentUser.full_name = 'Петров П.П. (Сотрудник)';
+      } else {
+        state.currentUser.role = 'ADMIN';
+        state.currentUser.full_name = 'Иванов И.И. (Администратор)';
+      }
+      render();
+    }
+
+    // Initial fetch and render
+    if (state.mode === 'catalog') {
+      fetchDocuments();
+    } else {
+      render();
+    }
+  </script>
+</body>
+</html>
