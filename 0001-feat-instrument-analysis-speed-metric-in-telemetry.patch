+                .andExpect(jsonPath("$.categorizedConcerns").value(8))
+                .andExpect(jsonPath("$.coverageRate").value(80.0));
+
+        verify(categorizationService, times(1)).calculateCoverage("reviewConcerns");
+    }
+
+    @Test
